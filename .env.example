# Copie este archivo como .env y complete los valores. .env NUNCA se sube a git.

# Usuario de la aplicación (solo CREATE SESSION + DML vía rol FIN_APP_ROLE).
ORACLE_USER=FIN_APP
ORACLE_PASSWORD=

# host:puerto/nombre_servicio  (ej. 192.168.1.10:1521/ORCLPDB)
ORACLE_CONNECT_STRING=localhost:1521/ORCLPDB

# Esquema dueño de las tablas de Financiero.
ORACLE_SCHEMA=FIN_OWNER

# Pool de conexiones
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5

# Servidor web
PORT=3000
